generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique(map: "users_email_key")
  password      String
  role          UserRole @default(PATIENT)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  admin         Admin?
  doctor        Doctor?
  patient       Patient?

  @@index([role])
  @@index([username], map: "users_email_idx")
  @@map("users")
}

model Admin {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  name            String    @default("System Administrator")
  email           String    @unique
  role            String    @default("SUPER_ADMIN")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedDoctors  Doctor[]  @relation("AdminDoctors")
  managedPatients Patient[] @relation("AdminPatients")

  @@index([email])
  @@map("admins")
}

model Patient {
  id                       String         @id @default(uuid())
  firstName                String
  middleName               String?
  lastName                 String
  suffix                   String?
  email                    String         @unique
  countryCode              String         @default("+1")
  phone                    String
  dob                      String
  gender                   String?
  address                  String?
  city                     String?
  state                    String?
  zipCode                  String?
  country                  String?
  password                 String
  hipaaConsent             Boolean        @default(false)
  isActive                 Boolean        @default(true)
  emailVerified            Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  allergies                String?
  bloodType                String?
  currentMedications       String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  existingConditions       String?
  height                   String?
  image                    String?
  weight                   String?
  createdById              String?        @map("created_by_id")
  userId                   String         @unique @map("user_id")
  currentSessionId         String?        @map("current_session_id")
  lastLoginDevice          String?        @map("last_login_device")
  lastLoginAt              DateTime?      @map("last_login_at")
  bookings                 Consultation[]
  medicalCertificates      MedicalCertificate[]
  createdBy                Admin?         @relation("AdminPatients", fields: [createdById], references: [id])
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([lastName, firstName])
  @@map("patients")
}

model Doctor {
  id                       String         @id @default(uuid())
  name                     String
  npi                      String         @unique
  email                    String         @unique
  password                 String
  specialty                String
  bio                      String?
  image                    String?
  languages                String[]       @default(["English"])
  rating                   Float          @default(0.0)
  reviewCount              Int            @default(0)
  availability             String         @default("Available")
  consultFee               Float?
  licenseNumber            String?
  licenseState             String?
  yearsExp                 Int?
  securityKey              String?
  isActive                 Boolean        @default(true)
  isFeatured               Boolean        @default(false)
  isVerified               Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  consultationDuration     Int            @default(30)
  consultationDurationUnit String         @default("minutes")
  status                   String         @default("ONLINE")
  firstName                String?        @map("first_name")
  middleName               String?        @map("middle_name")
  lastName                 String?        @map("last_name")
  suffix                   String?        @map("suffix")
  createdById              String?        @map("created_by_id")
  userId                   String         @unique @map("user_id")
  username                 String?        @unique
  currentSessionId         String?        @map("current_session_id")
  lastLoginDevice          String?        @map("last_login_device")
  lastLoginAt              DateTime?      @map("last_login_at")
  bookings                 Consultation[]
  audits                   DoctorAudit[]
  medicalCertificates      MedicalCertificate[]
  createdBy                Admin?         @relation("AdminDoctors", fields: [createdById], references: [id])
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([npi])
  @@index([specialty])
  @@map("doctors")
}

model Consultation {
  id              String             @id @default(uuid())
  patientId       String
  doctorId        String
  scheduledAt     DateTime           @default(now())
  status          ConsultationStatus @default(PENDING)
  reason          String?
  notes           String?
  prescription    String?
  duration        Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bloodPressure   String?
  heartRate       String?
  bodyTemperature String?
  doctor              Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  videoSession        VideoSession?
  medicalCertificates MedicalCertificate[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("consultations")
}

model VideoSession {
  id             String             @id @default(uuid())
  consultationId String             @unique
  status         VideoSessionStatus @default(WAITING)
  roomId         String             @unique
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  consultation   Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("video_sessions")
}

model DoctorAudit {
  id            String      @id @default(uuid())
  doctorId      String?     @map("doctor_id")
  npi           String
  licenseNumber String      @map("license_number")
  licenseState  String      @map("license_state")
  specialty     String
  medicalSchool String      @map("medical_school")
  gradYear      Int         @map("grad_year")
  yearsExp      Int         @map("years_exp")
  documentName  String?     @map("document_name")
  status        AuditStatus @default(PENDING)
  signature     String
  consent       Boolean     @default(false)
  submittedAt   DateTime    @default(now()) @map("submitted_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  firstName     String?     @map("first_name")
  middleName    String?     @map("middle_name")
  lastName      String?     @map("last_name")
  suffix        String?     @map("suffix")
  approvalType  String      @default("PRC_PRIMARY_SOURCE_VERIFICATION") @map("approval_type")
  doctor        Doctor?     @relation(fields: [doctorId], references: [id])

  @@index([npi])
  @@index([status])
  @@map("doctor_audits")
}

model MedicalCertificate {
  id             String        @id @default(uuid())
  consultationId String?       @map("consultation_id")
  doctorId       String        @map("doctor_id")
  patientId      String        @map("patient_id")
  purpose        String        // sick_leave | fitness_to_work | school | other
  diagnosis      String?
  remarks        String?
  restDaysFrom   DateTime?     @map("rest_days_from")
  restDaysTo     DateTime?     @map("rest_days_to")
  issuedAt       DateTime      @default(now()) @map("issued_at")
  certNumber     String        @unique @map("cert_number")
  doctor         Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  @@index([doctorId])
  @@index([patientId])
  @@map("medical_certificates")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  userType  String
  token     String   @unique
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  purpose   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_otps")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum VideoSessionStatus {
  WAITING
  STARTED
  ENDED
}

enum DoctorSpecialty {
  GENERAL_PRACTITIONER
  CARDIOLOGIST
  DERMATOLOGIST
  NEUROLOGIST
  PEDIATRICIAN
  PSYCHIATRIST
  ORTHOPEDIST
  GYNECOLOGIST
  ONCOLOGIST
  ENDOCRINOLOGIST
  OTHER
}

enum AuditStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}
